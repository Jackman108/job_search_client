{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "license": "Proprietary License",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "react-app-rewired build",
    "dev": "react-app-rewired start",
    "start": "serve -s build -l 3000",
    "test": "react-app-rewired test --watchAll=false --ci",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "typecheck": "tsc --noEmit",
    "check:structure": "node scripts/check-structure.mjs",
    "check:fsd": "node scripts/check-fsd.mjs",
    "eject": "react-app-rewired eject"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-query-devtools": "^5.66.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.1",
    "@types/qrcode.react": "^3.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axios": "^1.7.9",
    "caniuse-lite": "^1.0.30001699",
    "dotenv": "^16.4.7",
    "i18next": "^24.2.2",
    "jwt-decode": "^4.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.1",
    "react-router-dom": "^7.1.5",
    "react-scripts": "^5.0.1",
    "typescript": "^5.7.3",
    "web-vitals": "^4.2.4"
  },
  "jest": {
    "moduleNameMapper": {
      "^@app/(.*)$": "<rootDir>/src/app/$1",
      "^@features/(.*)$": "<rootDir>/src/features/$1",
      "^@shared/(.*)$": "<rootDir>/src/shared/$1",
      "^@entities/(.*)$": "<rootDir>/src/entities/$1",
      "^@api$": "<rootDir>/src/shared/api/index.ts",
      "^@ui$": "<rootDir>/src/shared/ui/index.ts",
      "^@type$": "<rootDir>/src/shared/types/index.ts",
      "^@hooks$": "<rootDir>/src/shared/hooks/index.ts",
      "^@utils$": "<rootDir>/src/shared/utils/index.ts",
      "^@config$": "<rootDir>/src/shared/config/index.ts",
      "^@styles$": "<rootDir>/src/shared/styles/index.ts"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },

  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@tanstack/eslint-plugin-query": "^5.66.0",
    "@testing-library/dom": "^10.4.0",
    "@types/body-parser": "^1.19.5",
    "@types/i18next": "^13.0.0",
    "@types/jwt-decode": "^3.1.0",
    "@types/react-i18next": "^8.1.0",
    "customize-cra": "^1.0.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "react-app-rewire-alias": "^1.1.7",
    "react-app-rewired": "^2.2.1",
    "serve": "^14.2.3"
  }
}
